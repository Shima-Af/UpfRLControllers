.venv/
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/

# data/external/ holds digital-twin artifacts. Ignore everything inside,
# but keep the directory structure, .dvc pointer files, and .gitkeep so
# `dvc pull` + the bootstrap script can re-populate it on any machine.
data/external/**
!data/external/
!data/external/**/
!data/external/**/*.dvc
!data/external/.gitkeep

results/*
!results/.gitkeep
experiments/*
!experiments/.gitkeep
notebooks/.ipynb_checkpoints/
logs/
outputs/
mlruns/
.env
.DS_Store
